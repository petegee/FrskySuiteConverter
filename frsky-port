# ----------------------------------------------------------------- step 12: verify

step_12_verify() {
    export PATH="$CACHE_DIR/node/bin:$PATH"
    local vtmp="$WORK_DIR/tmp-verify"
    rm -rf "$vtmp"; mkdir -p "$vtmp"
    # 12a. Packed asar: the six loader-critical paths must be Linux ELFs.
    npx -y @electron/asar extract "$STAGE_ROOT/opt/frsky-suite/resources/app.asar" "$vtmp/asar" >/dev/null 2>&1
    local f fail=0
    for f in node_modules/drivelist/build/Release/drivelist.node \
             node_modules/node-hid/build/Release/HID.node \
             node_modules/node-hid/build/Release/HID_hidraw.node \
             node_modules/@serialport/bindings-cpp/prebuilds/linux-x64/node.napi.glibc.node \
             node_modules/usb/prebuilds/linux-x64/node.napi.glibc.node \
             node_modules/koffi/build/koffi/linux_x64/koffi.node; do
        if file "$vtmp/asar/$f" | grep -q "ELF 64-bit LSB shared object, x86-64"; then
            log "verify" "ELF ok: $f"
        else
            log "verify" "NOT an x86-64 ELF: $f"; fail=1
        fi
    done
    grep -q "path.join(__dirname, 'browser/index.html');" "$vtmp/asar/app/main.js" \
        || { log "verify" "main.js indexPath patch missing"; fail=1; }
    grep -q "execFileSync('sync')" "$vtmp/asar/app/devices/removable-disks.js" \
        || { log "verify" "drive-lock flush patch missing"; fail=1; }
    grep -q "linuxRadioDisksToMount" "$vtmp/asar/app/devices/removable-disks.js" \
        || { log "verify" "linux auto-mount patch missing"; fail=1; }
    ELECTRON_RUN_AS_NODE=1 "$ELECTRON_DIST/electron" \
        --check "$vtmp/asar/app/devices/removable-disks.js" \
        || { log "verify" "patched removable-disks.js does not parse"; fail=1; }
    [ "$fail" = "0" ] || die "asar verification failed"
    # 12b. N-API load test with the real Electron runtime (proves ABI match).
    ELECTRON_RUN_AS_NODE=1 "$ELECTRON_DIST/electron" -e "
const base='$vtmp/asar/node_modules';
for (const m of ['usb','node-hid','serialport','drivelist','koffi']) require(base+'/'+m);
console.log('native load test passed');
" || die "native load test failed (N-API/ABI mismatch?)"
    # 12c. Packaging lint.
    if command -v desktop-file-validate >/dev/null 2>&1; then
        dpkg-deb -x "$OUT_DEB" "$vtmp/deb"
        dpkg-deb -e "$OUT_DEB" "$vtmp/deb/DEBIAN"
        desktop-file-validate "$vtmp/deb/usr/share/applications/frsky-suite.desktop" \
            || die "desktop-file-validate failed"
        sh -n "$vtmp/deb/DEBIAN/postinst" && sh -n "$vtmp/deb/DEBIAN/prerm" \
            || die "maintainer script syntax check failed"
        # NOTE: never pipe dpkg-deb -c into `grep -q` here: grep's early exit
        # SIGPIPEs the writer and pipefail turns that into a false failure.
        dpkg-deb -c "$OUT_DEB" > "$vtmp/contents.txt"
        for k in app.asar dfu-util frsky-suite.desktop 99-frsky-suite.rules; do
            grep -q "$k" "$vtmp/contents.txt" || die "deb contents lack $k"
        done
        [ -L "$vtmp/deb/usr/bin/frsky-suite" ] || die "/usr/bin symlink missing"
    else
        log "verify" "WARNING: desktop-file-validate not installed, skipping lint"
    fi
    rm -rf "$vtmp"
    log "verify" "all checks passed"
}

# ---------------------------------------------------------------- step 13: install

step_13_install() {
    case "$INSTALL_MODE" in
        no) log "install" "skipped (--no-install). Deb: $OUT_DEB"; return ;;
        prompt)
            printf 'Install %s now? [Y/n] ' "$OUT_DEB"
            read -r ans
            case "$ans" in [nN]*) log "install" "declined. Deb: $OUT_DEB"; return ;; esac
            ;;
    esac
    command -v sudo >/dev/null 2>&1 || [ "$(id -u)" -eq 0 ] \
        || die "need sudo or root to install"
    as_root dpkg -i "$OUT_DEB"
    log "install" "done. Log out/in (or reboot) for the udev/USB permissions, then reconnect the radio."
}

